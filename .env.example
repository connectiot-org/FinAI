# ─────────────────────────────────────────────────────────────────────────────
# FInAI environment configuration
# Copy to `.env` (local) or configure in your hosting provider (Vercel, etc.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required for conversations, usage tracking, audit) ────────────
# PostgreSQL connection string. The Prisma schema (prisma/schema.prisma) uses
# provider "postgresql" — a SQLite file URL will NOT work.
# Example (Neon):     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/finai?sslmode=require
# Example (local):    postgresql://postgres:postgres@localhost:5432/finai
DATABASE_URL="postgresql://user:password@localhost:5432/finai"

# Optional direct (non-pooled) URL used by `prisma migrate`.
# DIRECT_URL="postgresql://user:password@localhost:5432/finai"

# ── Auth (required in production) ────────────────────────────────────────────
# NextAuth signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32+-char-random-secret"

# Public origin of the app (used for OAuth callbacks).
APP_URL="http://localhost:3000"

# Optional Google OAuth (if unset, only email+password credentials are offered)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Gate /agent and protected APIs behind a session (default: false, demo-open)
# STRICT_AUTH="false"

# ── AI Gateway (required for live chat) ──────────────────────────────────────
# OpenRouter API key — create one at https://openrouter.ai/keys
# NEVER commit real keys. No default key exists in the codebase.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# Optional: point the gateway at an OpenRouter-compatible proxy.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
